{
  "name": "blink-expo-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 npx expo start --web --port 3000",
    "start": "EXPO_NO_TELEMETRY=1 npx expo start",
    "start:web": "EXPO_NO_TELEMETRY=1 npx expo start --web",
    "start:ios": "EXPO_NO_TELEMETRY=1 npx expo start --ios",
    "start:android": "EXPO_NO_TELEMETRY=1 npx expo start --android",
    "build:web": "EXPO_NO_TELEMETRY=1 npx expo export --platform web",
    "build:ios": "EXPO_NO_TELEMETRY=1 eas build --platform ios",
    "build:android": "EXPO_NO_TELEMETRY=1 eas build --platform android",
    "setup": "EXPO_NO_TELEMETRY=1 npx expo install",
    "install:bun": "bun install",
    "install:fast": "bun install --no-postinstall",
    "add": "bun add",
    "doctor": "EXPO_NO_TELEMETRY=1 npx expo-doctor",
    "lint": "EXPO_NO_TELEMETRY=1 npx expo lint",
    "prebuild": "EXPO_NO_TELEMETRY=1 npx expo prebuild",
    "prebuild:clean": "EXPO_NO_TELEMETRY=1 npx expo prebuild --clean"
  },
  "dependencies": {
    "@blinkdotnew/mobile-ui": "2.0.1",
    "@blinkdotnew/sdk": "2.11.3",
    "@expo/vector-icons": "15.1.1",
    "@legendapp/list": "2.0.19",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.105.0",
    "expo": "58.0.20",
    "expo-audio": "58.0.10",
    "expo-blur": "58.0.5",
    "expo-build-properties": "58.0.11",
    "expo-constants": "58.0.13",
    "expo-font": "58.0.10",
    "expo-haptics": "58.0.7",
    "expo-image": "58.0.17",
    "expo-image-picker": "58.0.10",
    "expo-linear-gradient": "58.0.3",
    "expo-linking": "58.0.14",
    "expo-location": "58.0.19",
    "expo-router": "58.0.27",
    "expo-splash-screen": "58.0.11",
    "expo-status-bar": "58.0.4",
    "expo-symbols": "58.0.4",
    "expo-system-ui": "58.0.6",
    "expo-video": "58.0.12",
    "expo-web-browser": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@expo/ngrok": "4.1.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "typescript": "6.0.3"
  }
}
